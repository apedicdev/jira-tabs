{
  "name": "jira-tabs-desktop",
  "productName": "Jira Tabs",
  "version": "1.0.0",
  "description": "Jira (with Confluence) or GitLab in its own app, with one tab per issue, merge request or page.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:gitlab": "APP_PROFILE=gitlab electron .",
    "dist": "npm run dist:jira && npm run dist:gitlab",
    "dist:jira": "electron-builder --mac --publish never",
    "dist:gitlab": "electron-builder --mac --publish never --config build/gitlab.config.js"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "io.github.apedicdev.jira-tabs",
    "productName": "Jira Tabs",
    "files": [
      "src/**/*",
      "config.json",
      "config.local.json",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist/jira"
    },
    "protocols": [
      {
        "name": "Jira Tabs link",
        "schemes": [
          "jira-tabs"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/jira/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/jira/icon.png",
      "target": "nsis"
    },
    "dmg": {
      "title": "Jira Tabs"
    }
  }
}
