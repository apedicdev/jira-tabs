# Copy to .env and fill in. Without credentials the app runs on demo data.

# Jira Cloud: your site, your Atlassian email and a classic API token from
# https://id.atlassian.com/manage-profile/security/api-tokens ("Create API token", not "with scopes")
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Jira Data Center / Server instead: set JIRA_BASE_URL above and a personal access token here
# JIRA_PAT=

# Optional
# PORT=4300
